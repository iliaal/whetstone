#!/usr/bin/env python3
import itertools
import json
import os
import re
import subprocess
import sys
import urllib.parse
from html.parser import HTMLParser


def gh(*args):
    result = subprocess.run(["gh", *args], capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"gh exited {result.returncode}")
    return json.loads(result.stdout)


def graphql(query, **fields):
    args = ["api", "graphql", "-f", "query=" + query]
    for name, value in fields.items():
        if value is not None:
            args.extend(["-F" if isinstance(value, int) else "-f", f"{name}={value}"])
    response = gh(*args)
    if response.get("errors"):
        raise RuntimeError("GraphQL errors: " + json.dumps(response["errors"]))
    if not response.get("data"):
        raise RuntimeError("GraphQL response has no data")
    return response["data"]


def pages(fetch, initial=None):
    cursor = None
    seen = set()
    nodes = []
    while True:
        connection = initial if initial is not None else fetch(cursor)
        initial = None
        nodes.extend(connection["nodes"])
        info = connection["pageInfo"]
        if not info["hasNextPage"]:
            return nodes
        cursor = info["endCursor"]
        if not cursor or cursor in seen:
            raise RuntimeError("Pagination did not advance; feedback is incomplete")
        seen.add(cursor)


PAGE = "pageInfo { hasNextPage endCursor }"
AUTHOR = "author { login __typename } authorAssociation"
COMMENT = "id " + AUTHOR + " body bodyHTML createdAt url"
REVIEW = "id " + AUTHOR + " body bodyHTML state submittedAt url"
THREAD_COMMENT = COMMENT + " updatedAt outdated"
THREAD = "id isResolved isOutdated isCollapsed path line startLine diffSide"
# The legacy `permission` field folds maintain into write and triage into read.
WRITE_PERMISSIONS = {"admin", "write"}
ALLOWLIST_ENV = "PR_COMMENT_TRUSTED_LOGINS"
HTML_SPACE = re.compile(r"[ \t\n\r\f]+")
HTML_COMMENT = re.compile(r"<!--(.*?)(?:-->|\Z)", re.S)
BLOCK_TAGS = {"address", "article", "aside", "blockquote", "br", "dd", "details", "div", "dl",
              "dt", "figcaption", "figure", "footer", "h1", "h2", "h3", "h4", "h5", "h6",
              "header", "hr", "li", "ol", "p", "pre", "section", "summary", "table", "td",
              "th", "tr", "ul"}
VOID_TAGS = {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
             "source", "track", "wbr"}
# A suggested-change block shows a "Suggested change" label and the lines it
# replaces, which are repository text, not the commenter's words.
SUGGESTION = "js-suggested-changes-blob"
SUGGESTION_ADDED = "blob-code-addition"
# GitHub strips class attributes from user HTML, so these classes mark its own markup:
# the screen-reader footnote heading, the footnote back-reference arrow, the toggle
# for a collapsed email reply, and a permalink's embedded file lines and their header.
UI_ONLY_CLASSES = {"sr-only", "data-footnote-backref", "email-hidden-toggle", "Box--condensed",
                   "blob-wrapper-embedded"}
# The earlier message an email reply quotes, as GitHub's email parser marks it.
QUOTE_CLASSES = {"email-quoted-reply", "email-hidden-reply"}


class Verbatim(str):
    """Source text from <pre> or a suggested line, kept byte-exact by tidy()."""

def allowlist():
    entries = os.environ.get(ALLOWLIST_ENV, "").split(",")
    return {entry.strip().lower().removesuffix("[bot]") for entry in entries if entry.strip()}


class RenderedText(HTMLParser):
    """Split GitHub-rendered HTML into text outside and inside a quote."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.own, self.quoted = [], []
        self.stack = []
        self.quote_depth = 0
        self.verbatim_depth = 0
        self.suggestion_lines = 0
        self.pre_start = 0

    def emitting(self):
        return self.stack[-1][1] if self.stack else True

    def in_suggestion(self):
        return bool(self.stack) and self.stack[-1][2]

    def block_break(self):
        # Suggestion table cells are code lines; their row and cell breaks are not text.
        if not self.in_suggestion():
            self.own.append("\n")
            self.quoted.append("\n")

    def handle_starttag(self, tag, attrs):
        if tag in BLOCK_TAGS:
            self.block_break()
        if tag in VOID_TAGS:
            return
        classes = set((dict(attrs).get("class") or "").split())
        in_suggestion = self.in_suggestion() or SUGGESTION in classes
        added_line = False
        if in_suggestion:
            added_line = tag == "td" and SUGGESTION_ADDED in classes
            emit = added_line or (self.emitting() and SUGGESTION not in classes)
            if SUGGESTION in classes and not self.in_suggestion():
                self.suggestion_lines = 0
        else:
            emit = self.emitting() and not (classes & UI_ONLY_CLASSES)
        quote = tag == "blockquote" or bool(classes & QUOTE_CLASSES)
        if added_line:
            if self.suggestion_lines:
                (self.quoted if self.quote_depth else self.own).append(Verbatim("\n"))
            self.suggestion_lines += 1
        verbatim = tag == "pre" or added_line
        self.quote_depth += quote
        self.verbatim_depth += verbatim
        if tag == "pre":
            self.pre_start = len(self.quoted if self.quote_depth else self.own)
        self.stack.append((tag, emit, in_suggestion, quote, verbatim))

    def handle_startendtag(self, tag, attrs):
        self.handle_starttag(tag, attrs)
        if tag not in VOID_TAGS:
            self.handle_endtag(tag)

    def handle_endtag(self, tag):
        if not any(frame[0] == tag for frame in self.stack):
            if tag in BLOCK_TAGS:
                self.block_break()
            if tag == "blockquote":
                raise ValueError("unbalanced blockquote")
            return
        while True:
            open_tag, _, _, quote, verbatim = self.stack.pop()
            if quote:
                if open_tag != tag:
                    raise ValueError("quote closed by </" + tag + ">")
                self.quote_depth -= 1
            self.verbatim_depth -= verbatim
            if open_tag == "pre":
                self.drop_final_newline()
            if open_tag == tag:
                break
        if tag in BLOCK_TAGS:
            self.block_break()

    def drop_final_newline(self):
        # A fenced block renders as <pre><code>line\n</code></pre>; that last newline
        # ends the final source line and is not a blank line.
        parts = self.quoted if self.quote_depth else self.own
        if len(parts) > self.pre_start and isinstance(parts[-1], Verbatim) and parts[-1].endswith("\n"):
            parts[-1] = Verbatim(parts[-1][:-1])

    def handle_data(self, data):
        if not self.emitting():
            return
        parts = self.quoted if self.quote_depth else self.own
        if self.verbatim_depth:
            parts.append(Verbatim(data))
            return
        # Outside <pre> and suggested lines, a browser collapses ASCII whitespace and
        # drops it at a line start.
        data = HTML_SPACE.sub(" ", data)
        if not parts or parts[-1].endswith("\n"):
            data = data.lstrip(" ")
        parts.append(data)


def tidy(parts):
    """Trim prose line ends and blank runs; leave Verbatim source text untouched."""
    chunks = []
    for verbatim, group in itertools.groupby(parts, key=lambda part: isinstance(part, Verbatim)):
        text = "".join(group)
        if not verbatim:
            text = re.sub(r"\n{3,}", "\n\n", re.sub(r"[^\S\n]+\n", "\n", text))
        chunks.append((verbatim, text))
    if chunks and not chunks[0][0]:
        chunks[0] = (False, chunks[0][1].lstrip("\n"))
    if chunks and not chunks[-1][0]:
        chunks[-1] = (False, chunks[-1][1].rstrip())
    return "".join(text for _, text in chunks)


def split_body(body, html):
    """Return (author_text, quoted_text, hidden_text, render_unavailable).

    author_text and quoted_text come from GitHub's rendered HTML, so they match
    what GitHub shows: text inside <blockquote> or an email reply's quoted
    part, at any depth, is quoted, and
    markup that never renders (HTML comments, link-reference definitions,
    footnote definitions, processing instructions) is absent. hidden_text is a
    best-effort pull of HTML comments from the raw body, including ones inside
    quotes or code, kept so a stop or hold request there can be surfaced to the
    user for confirmation. Missing or malformed HTML yields no
    author_text and render_unavailable, never a fallback to the raw body.
    """
    raw = (body or "").replace("\r\n", "\n").replace("\r", "\n")
    hidden = "\n".join(part.strip() for part in HTML_COMMENT.findall(raw)).strip()
    if not isinstance(html, str):
        return "", "", hidden, True
    parser = RenderedText()
    try:
        parser.feed(html)
        parser.close()
    except (ValueError, AssertionError):
        return "", "", hidden, True
    if parser.quote_depth:
        return "", "", hidden, True
    return tidy(parser.own), tidy(parser.quoted), hidden, False


def write_access(owner, repo, login):
    path = "repos/{}/{}/collaborators/{}/permission".format(
        *(urllib.parse.quote(part, safe="") for part in (owner, repo, login)))
    try:
        permission = gh("api", path).get("permission")
    except (OSError, ValueError, AttributeError, RuntimeError):
        return "unknown", False
    if not isinstance(permission, str):
        return "unknown", False
    return permission, permission in WRITE_PERMISSIONS


def annotate(item, allowed, permissions):
    author = item.get("author") or {}
    login = author.get("login")
    is_bot = author.get("__typename") == "Bot"
    association = item.get("authorAssociation") or "NONE"
    allowlisted = login is not None and login.lower().removesuffix("[bot]") in allowed
    permission, has_write = None, False
    if login is not None and not is_bot and not allowlisted:
        permission, has_write = permissions(login)
    own, quoted, hidden, unavailable = split_body(item.get("body"), item.get("bodyHTML"))
    fields = {key: value for key, value in item.items() if key != "bodyHTML"}
    return {**fields, "author": login or "unknown", "author_association": association,
            "author_is_bot": is_bot, "author_permission": permission,
            "trusted": (allowlisted or has_write) and not unavailable,
            "render_unavailable": unavailable,
            "author_text": own, "quoted_text": quoted, "hidden_text": hidden}


def main():
    if len(sys.argv) not in (2, 3) or not sys.argv[1].isdigit() or int(sys.argv[1]) < 1:
        raise RuntimeError("Usage: get-pr-comments PR_NUMBER [OWNER/REPO]")
    pr = int(sys.argv[1])
    if len(sys.argv) == 3:
        parts = sys.argv[2].split("/")
        if len(parts) != 2 or not all(parts):
            raise RuntimeError("Repository must be OWNER/REPO")
        owner, repo = parts
    else:
        detected = gh("repo", "view", "--json", "owner,name")
        owner, repo = detected["owner"]["login"], detected["name"]

    metadata = graphql(
        """query FeedbackMetadata($owner: String!, $repo: String!, $pr: Int!) {
          repository(owner: $owner, name: $repo) {
            pullRequest(number: $pr) { author { login } }
          }
        }""", owner=owner, repo=repo, pr=pr
    )["repository"]["pullRequest"]
    if metadata is None:
        raise RuntimeError("Pull request not found")
    author = (metadata.get("author") or {}).get("login")
    allowed = allowlist()
    cache = {}

    def permissions(login):
        key = login.lower()
        if key not in cache:
            cache[key] = write_access(owner, repo, login)
        return cache[key]

    def connection(name, fields):
        query = (
            "query FeedbackPage($owner: String!, $repo: String!, $pr: Int!, $cursor: String) {"
            "repository(owner: $owner, name: $repo) { pullRequest(number: $pr) {"
            + name + "(first: 100, after: $cursor) { nodes {" + fields + "} " + PAGE + "}"
            "}}}"
        )
        return pages(lambda cursor: graphql(
            query, owner=owner, repo=repo, pr=pr, cursor=cursor
        )["repository"]["pullRequest"][name])

    comments = connection("comments", COMMENT)
    reviews = connection("reviews", REVIEW)
    threads = connection("reviewThreads", THREAD + " comments(first: 100) { totalCount nodes {"
                         + THREAD_COMMENT + "} " + PAGE + "}")
    for thread in threads:
        query = (
            "query ThreadComments($thread: ID!, $cursor: String) { node(id: $thread) {"
            "... on PullRequestReviewThread { comments(first: 100, after: $cursor) {"
            "nodes {" + THREAD_COMMENT + "} " + PAGE + "}}}}"
        )
        thread_comments = pages(lambda cursor: graphql(
            query, thread=thread["id"], cursor=cursor
        )["node"]["comments"], initial=thread["comments"])
        thread_comments = [annotate(item, allowed, permissions) for item in thread_comments]
        thread["comments"] = {"totalCount": len(thread_comments), "nodes": thread_comments}
        thread["trusted"] = bool(thread_comments) and all(item["trusted"] for item in thread_comments)

    def conversation(items):
        result = []
        for item in items:
            if not (item.get("body") or "").strip():
                continue
            entry = annotate(item, allowed, permissions)
            result.append({**entry, "by_pr_author": author is not None
                           and entry["author"] == author})
        return result

    unresolved = [{"node": thread} for thread in threads
                  if not thread["isResolved"] and not thread["isOutdated"]]
    resolved = [{"node": {key: thread.get(key) for key in ("id", "path", "line")}}
                for thread in threads if thread["isResolved"]]
    print(json.dumps({
        "unresolved": unresolved,
        "conversation": {"pr_author": author or "unknown",
                         "comments": conversation(comments),
                         "review_bodies": conversation(reviews)},
        "cross_invocation": {"signal": bool(resolved and unresolved),
                             "resolved_threads": resolved},
    }))


try:
    main()
except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
    print(f"Error fetching PR feedback: {error}", file=sys.stderr)
    sys.exit(1)
